[ext_resource type="AudioStream" path="res://Assets/Audio/sound_effects/CartillaBg.mp3" id="3_musica"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_cartilla"]
bg_color = Color(1.0, 0.95, 0.55, 0.95)
